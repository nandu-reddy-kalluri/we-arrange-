# Supabase Public Configuration for apps/web (safe for browser via NEXT_PUBLIC_ prefix)
# Project: YouMarriageWeArrange (ref: zujjiiljvjwgcxtaqype, region: ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=https://zujjiiljvjwgcxtaqype.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional fallback if using Supabase's newer publishable key variable name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Application URL (used for metadata, sitemap, and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase Service Role key (NEVER prefix with NEXT_PUBLIC_ or commit)
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional Cloudflare R2 Media Storage (server-only)
# CLOUDFLARE_R2_ACCOUNT_ID=your-r2-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# CLOUDFLARE_R2_BUCKET=ymwa-media
# CLOUDFLARE_R2_PUBLIC_BASE_URL=https://cdn.example.com

# Optional Payment Gateway & Webhook Verification (server-only)
# PAYMENT_GATEWAY_PROVIDER=razorpay
# PAYMENT_GATEWAY_KEY_ID=your-key-id
# PAYMENT_GATEWAY_KEY_SECRET=your-key-secret
# PAYMENT_WEBHOOK_SECRET=your-hmac-webhook-secret

# Optional Email / SMS / Notification Webhook Providers (server-only)
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_API_KEY=your-email-api-key
# SMS_PROVIDER=twilio
# SMS_PROVIDER_API_KEY=your-sms-api-key
# NOTIFICATION_WEBHOOK_SECRET=your-notification-webhook-secret


